# dev libera rodar sem API_KEYS; prod recusa subir sem chave (app/auth.py).
ENVIRONMENT=dev

ANTHROPIC_API_KEY=
BRASILAPI_URL=https://brasilapi.com.br/api
DATABASE_URL=sqlite+aiosqlite:///./lead_router.db

# Fila do worker. Sem Redis de pé o POST grava o lead e falha ao enfileirar:
# o lead não se perde, mas ninguém o processa.
REDIS_URL=redis://localhost:6379

# Lista separada por vírgula de chaves aceitas no header X-API-Key.
API_KEYS=

# Origens de browser permitidas no CORS. Vazio = nenhuma.
CORS_ORIGINS=http://localhost:3000

# Teto de requisições por minuto, por chave (ou por IP quando não há chave).
RATE_LIMIT_PER_MINUTE=60

# Destino do webhook de saída. Precisa ser https e ter o host listado abaixo.
OUTBOUND_WEBHOOK_URL=
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_SIGNING_SECRET=
MIN_SCORE_TO_DISPATCH=60
